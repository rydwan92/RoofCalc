{
  "name": "@cieslacalc/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "db:generate": "cd ../.. && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "cd ../.. && drizzle-kit migrate --config drizzle.config.ts",
    "catalog:import": "tsx src/cli/import-catalog.ts",
    "pricing:import": "tsx src/cli/import-pricing.ts",
    "db:wait": "tsx src/cli/wait-for-db.ts",
    "db:doctor": "tsx src/cli/doctor.ts",
    "db:seed": "tsx src/cli/seed-all.ts --apply",
    "db:smoke-check": "tsx src/cli/smoke-check.ts",
    "db:bootstrap": "pnpm db:wait && pnpm db:migrate && pnpm db:seed && pnpm db:smoke-check"
  },
  "dependencies": {
    "@cieslacalc/catalog-core": "workspace:*",
    "@cieslacalc/covering-core": "workspace:*",
    "@cieslacalc/pricing-core": "workspace:*",
    "@cieslacalc/shared": "workspace:*",
    "drizzle-orm": "0.44.0",
    "express": "^4.21.2",
    "mysql2": "3.14.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
