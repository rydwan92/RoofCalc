{
  "name": "@cieslacalc/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "business:create-user": "tsx src/cli/create-business-user.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "build:edge": "wrangler deploy --dry-run --config ../../wrangler.jsonc --outdir .wrangler/v42-dryrun && node ../../tools/check-edge-bundle.mjs",
    "db:generate": "cd ../.. && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "catalog:import": "tsx src/cli/import-catalog.ts",
    "pricing:import": "tsx src/cli/import-pricing.ts",
    "db:wait": "tsx src/cli/wait-for-db.ts",
    "db:doctor": "tsx src/cli/doctor.ts",
    "db:status": "tsx src/cli/status.ts",
    "db:seed": "tsx src/cli/seed-all.ts --apply",
    "db:seed-business": "tsx src/cli/seed-business.ts --apply",
    "db:smoke-check": "tsx src/cli/smoke-check.ts",
    "db:bootstrap": "pnpm db:wait && pnpm db:migrate && pnpm db:seed && pnpm db:seed-business && pnpm db:smoke-check && pnpm db:status",
    "db:setup:local": "tsx src/cli/setup-database.ts local",
    "db:setup:shared-dev": "tsx src/cli/setup-database.ts shared-dev",
    "deploy:cloudflare": "wrangler deploy --config ../../wrangler.jsonc"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@cieslacalc/business-core": "workspace:*",
    "@cieslacalc/catalog-core": "workspace:*",
    "@cieslacalc/covering-core": "workspace:*",
    "@cieslacalc/pricing-core": "workspace:*",
    "@cieslacalc/project-core": "workspace:*",
    "@cieslacalc/quote-core": "workspace:*",
    "@cieslacalc/roof-system-core": "workspace:*",
    "@cieslacalc/shared": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "mysql2": "3.14.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "wrangler": "^4.132.0"
  }
}
