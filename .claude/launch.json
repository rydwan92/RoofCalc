{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "pnpm@10.15.1",
        "--filter",
        "@cieslacalc/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "pnpm@10.15.1",
        "--filter",
        "@cieslacalc/web",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "pnpm@10.15.1",
        "--filter",
        "@cieslacalc/api",
        "exec",
        "tsx",
        "src/server.ts"
      ],
      "port": 3001
    }
  ]
}
