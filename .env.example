# Optional. Geometry and saved local projects work without the catalogue DB/API.
#
# Option A — an existing local XAMPP MariaDB on the default port 3306:
# create the database first and adapt the user/password explicitly; never
# commit real credentials.
DATABASE_URL=mysql://catalog_user:change-me@127.0.0.1:3306/cieslacalc
#
# Option B — the bundled `compose.yaml` MariaDB (see `MARIADB_*` below),
# on port 3307 so it never collides with an existing XAMPP instance:
# DATABASE_URL=mysql://catalog_user:change-me@127.0.0.1:3307/cieslacalc
# Option C — shared alwaysdata DEV, also read by Cloudflare through Hyperdrive
# (private root .env only; never commit the password; encode @ as %40).
# Remote hosts always use verified TLS; loopback hosts use plain TCP unless
# ?ssl=required is appended. See docs/ARCHITECTURE_V45_SHARED_DEV_DATABASE_AND_HYPERDRIVE.md.
# DATABASE_URL=mysql://<USER>:<PASSWORD>@mysql-<ACCOUNT>.alwaysdata.net:3306/<DATABASE>
# Remote mutation also requires ROOFCALC_DB_ENV=shared-dev and the explicit
# `pnpm db:setup:shared-dev -- --apply --confirm shared-dev` acknowledgement.
# ROOFCALC_DB_ENV=shared-dev
HOST=127.0.0.1
PORT=3001

# Only read by `docker compose up` (compose.yaml) — irrelevant to XAMPP.
# MARIADB_USER/MARIADB_PASSWORD must match the credentials in DATABASE_URL
# above when using Option B.
MARIADB_HOST_PORT=3307
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=cieslacalc
MARIADB_USER=catalog_user
MARIADB_PASSWORD=change-me
