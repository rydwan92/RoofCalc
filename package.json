{
  "name": "cieslacalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "pnpm --filter @cieslacalc/web build && pnpm --filter @cieslacalc/api build && pnpm --filter @cieslacalc/api build:edge",
    "build:edge": "pnpm --filter @cieslacalc/web build && pnpm --filter @cieslacalc/api build:edge",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shared-db": "vitest run apps/api/src/shared-database.integration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:architecture": "vitest run tools/architecture",
    "test:fixtures": "vitest run fixtures",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:bootstrap": "pnpm --filter @cieslacalc/api db:bootstrap",
    "db:doctor": "pnpm --filter @cieslacalc/api db:doctor",
    "dev:full": "pnpm db:bootstrap && pnpm dev",
    "dev:remote": "pnpm db:doctor && pnpm dev",
    "deploy:cloudflare": "pnpm build:edge && pnpm --filter @cieslacalc/api deploy:cloudflare"
  },
  "devDependencies": {
    "@cieslacalc/calculator-core": "workspace:*",
    "@cieslacalc/covering-core": "workspace:*",
    "@cieslacalc/document-core": "workspace:*",
    "@cieslacalc/linear-procurement": "workspace:*",
    "@cieslacalc/procurement-core": "workspace:*",
    "@cieslacalc/project-core": "workspace:*",
    "@cieslacalc/quantity-core": "workspace:*",
    "@cieslacalc/roof-math": "workspace:*",
    "@cieslacalc/tile-procurement": "workspace:*",
    "@cieslacalc/timber-model": "workspace:*",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0",
    "@cieslacalc/roof-system-core": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
